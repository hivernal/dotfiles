#!/sbin/openrc-run

IT8613_DEVICE="/sys/devices/platform/it87.2608"
IT8613_HWMON="$(echo ${IT8613_DEVICE}/hwmon/hwmon[0-9])"
K10TEMP_DEVICE="/sys/devices/pci0000:00/0000:00:18.3"
K10TEMP_HWMON="$(echo ${K10TEMP_DEVICE}/hwmon/hwmon[0-9])"
INTERVAL=1
SKEEP_ITER=5
PWM_FILE="${IT8613_HWMON}/pwm3"
TEMP_FILE="${K10TEMP_HWMON}/temp1_input"
# TEMPS_PWMS="35000:0 45000:80 55000:120 75000:180 95000:255"
TEMPS_PWMS="35000:0 45000:80 55000:140 75000:200 85000:255"

supervisor=supervise-daemon
command=/usr/local/bin/control-fan.sh
command_args="-t '${TEMPS_PWMS}' -f '${TEMP_FILE}' -F '${PWM_FILE}' -i ${INTERVAL} -s ${SKEEP_ITER}"

set_manual_mode() {
  echo 1 > "${PWM_FILE}_enable"
}

set_auto_mode() {
  echo 2 > "${PWM_FILE}_enable"
}

checkconfig() {
  [ -n "${IT8613_DEVICE}" ] && [ -n "${K10TEMP_DEVICE}" ]
}

start_pre() {
  checkconfig || return $?
  set_manual_mode
}

stop_pre() {
  checkconfig || return $?
}

stop_post() {
  # set_auto_mode
  set_manual_mode
  echo 125 > "${PWM_FILE}"
}
