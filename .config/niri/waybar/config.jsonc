{
  "spacing": 0,
  "layer": "bottom",
  "height": 26,
  "modules-left": ["niri/workspaces", "niri/window"],
  // "modules-center": ["clock"],
  "modules-right": ["niri/language", "wireplumber", "memory", "network", "clock"],

  "niri/workspaces": {
    "format": "{}",
    "hide-empty": true,
    "display-condition": "only-populated"
  },

  "niri/language": {
    "format": "KEY {} | ",
    "format-ru": "ru",
    "format-en": "en"
  },

  "wireplumber": {
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    // "format": "VOL {node_name} {volume}% | "
    "format-muted": "{node_name} muted | ",
    "format": "{node_name} {volume}% | "
  },

  "battery": {
    "format": "BAT {capacity}% | ",
    "format-icons": ["", "", "", "", ""]
  },

  "clock": {
    "format": "{:%T}",
    "interval": 1,
    "timezone": "Asia/Krasnoyarsk"
  },

  "memory": {
    "format": "MEM {used}Gi | ",
    "interval": 2
  },

  "network": {
    "format-wifi": "NET {essid} | ",
    "format-ethernet": "NET {ifname} | ",
    "format-disconnected": "NET disconnected | ",
    "format-icons": ["󰣾", "󰣴", "󰣶", "󰣸", "󰣺"],
    "interval": 2
  },

  "custom/mem": {
    "exec": "free -h | awk '(NR==2) {print $3}'",
    "format": "MEM {} | ",
    "interval": 2
  }
}
